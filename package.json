{
  "name": "serralheria-crm",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema Web de CRM, gestão de custos e geração de orçamentos profissionais para serralherias.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "db:generate": "drizzle-kit generate --config worker/drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply serralheria-crm-db --local --config worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply serralheria-crm-db --remote --config worker/wrangler.jsonc",
    "invite:create": "node scripts/create-invite.mjs",
    "user:reset-password": "node scripts/reset-password.mjs",
    "company:delete": "node scripts/delete-company.mjs",
    "test:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.107.1",
    "decimal.js-light": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
